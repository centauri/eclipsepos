<Window x:Class="EclipsePos.Apps.Views.Progress.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="117" Width="443"  Background="{DynamicResource BorderBrush}" ResizeMode="NoResize"  Opacity="1" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="OutboxHeaderBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BottomPanelBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="HeaderTextBrush" Color="{DynamicResource InkColor}"/>
        <SolidColorBrush x:Key="GridBodyBrush" Color="{DynamicResource SurfaceColor}"/>

        <LinearGradientBrush x:Key="GridShadowBrush" EndPoint="0.5,1.057" StartPoint="0.5,-0.057">
            <GradientStop Color="#33FFFFFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="{DynamicResource CanvasColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource LineColor}"/>

        </Window.Resources>

    <StackPanel Orientation="Vertical" Margin="5" >
        <ProgressBar  Margin="10,5,10,5" Name="progressBar1" VerticalAlignment="Top" Height="24" IsIndeterminate="False" />
        <TextBlock  Margin="10, 0,10,5"  Name="txtBlockProgressText" Foreground="White" FontSize="12"></TextBlock>
    </StackPanel>
</Window>
