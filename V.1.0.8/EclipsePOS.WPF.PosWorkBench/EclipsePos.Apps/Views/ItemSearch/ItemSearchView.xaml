 <UserControl x:Class="EclipsePos.Apps.Views.ItemSearch.ItemSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EclipsePos.Apps.Views"
     Name="rootControl"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
    <UserControl.Resources>
        <SolidColorBrush x:Key="OutboxHeaderBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BottomPanelBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="HeaderTextBrush" Color="{DynamicResource InkColor}"/>
        <SolidColorBrush x:Key="GridBodyBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="MenuHeadBrush" Color="{DynamicResource CanvasColor}"/>

        <LinearGradientBrush x:Key="GridShadowBrush" EndPoint="0.5,1.057" StartPoint="0.5,-0.057">
            <GradientStop Color="#33FFFFFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="{DynamicResource CanvasColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource LineColor}"/>
        <!-- XLS Button Style -->
        <Style x:Key="btnXLS" BasedOn="{x:Null}" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <!--Image Width="20" Height="20" Source="..\..\Images\xls.png" / -->
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"/>
                            <Trigger Property="IsDefaulted" Value="True"/>
                            <Trigger Property="IsMouseOver" Value="True"/>
                            <Trigger Property="IsPressed" Value="True"/>
                            <Trigger Property="IsEnabled" Value="False"/>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="GlassyButtonStyle1" TargetType="Button" BasedOn="{StaticResource ModernButton}"/>

        <Style x:Key="GlassyButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style x:Key="ListViewItemStyleBase" TargetType="{x:Type ListViewItem}">
            <Setter Property="BorderThickness" Value="1,1,1,1" />
            <Setter Property="BorderBrush" Value="#FF1D0F48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border BorderBrush="{DynamicResource GridBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5,5,5,5" Margin="-2,0,0,0"  >
                            <StackPanel>
                                <GridViewRowPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Yellow"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LstVwItmStyle1" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemStyleBase}">
            <Setter Property="Background" Value="#FFEBEBEB" />
        </Style>

        <Style x:Key="LstVwItmStyle2" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemStyleBase}">
            <Setter Property="Background" Value="#FFC9D5E1" />
        </Style>

        <local:ListViewItemStyleSelector x:Key="ListViewItemStyleSelector" />

        <!-- TBUC -->

        <Style x:Key="headerStyle1" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border  BorderThickness="2,2,0,2" CornerRadius="5,0,0,5" TextBlock.TextAlignment="Center" Width="{TemplateBinding  Width}" BorderBrush="#FF1D0F48" Background="#FFE2EFC3"  >
                            <ContentPresenter Content="{TemplateBinding Content}"  ></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="headerStyle2" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border  BorderThickness="0,2,0,2" CornerRadius="0,0,0,0" TextBlock.TextAlignment="Center" Width="{TemplateBinding  Width}" BorderBrush="#FF1D0F48" Background="#FFE2EFC3"  >
                            <ContentPresenter Content="{TemplateBinding Content}"  ></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="headerStyle3" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border  BorderThickness="0,2,2,2" CornerRadius="0,5,5,0" TextBlock.TextAlignment="Center" Width="{TemplateBinding  Width}" BorderBrush="#FF1D0F48" Background="#FFE2EFC3"  >
                            <ContentPresenter Content="{TemplateBinding Content}"  ></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="LeftPanelGradientBrush" EndPoint="0.208,1.062" StartPoint="0.792,-0.062">
            <GradientStop Color="#FF0F152B" Offset="0"/>
            <GradientStop Color="#FF413A70" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DragNDropGradientBrush" EndPoint="0.012,0.986" StartPoint="0.988,0.014">
            <GradientStop Color="#FF195078" Offset="0"/>
            <GradientStop Color="#FF2F5D96" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>


   
    <Border  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,0,10,10" Width="Auto" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1,1,1,1" >

        <Grid Name="MyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="90"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Name="txtBlockMenuName" Text="Item Search" Margin="0,0,0,5" Foreground="#FFFFFFFF" FontSize="17" TextAlignment="Center" Background="{StaticResource MenuHeadBrush}"></TextBlock>
            <ListView Grid.Row ="1" Grid.Column="0" Grid.ColumnSpan="6" Background ="{DynamicResource GridBrush}"    x:Name="itemSerchListView"   ItemsSource ="{Binding}"  FontSize="14" ItemContainerStyleSelector="{StaticResource ListViewItemStyleSelector}" IsSynchronizedWithCurrentItem="True" Focusable="False" Margin="3,0,3,0" >
                <ListView.View>
                    <GridView AllowsColumnReorder="False"  >

                        <GridViewColumn x:Name="columnHeaderDescription" Header="Description" Width="150"  HeaderContainerStyle="{StaticResource headerStyle2}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridBrush}" BorderThickness="0,0,1,0" Margin="0,0,0,0">
                                        <TextBlock Margin="1,0,0,0" Name="txtBlockDescription"  Text="{Binding Path=short_desc}"    HorizontalAlignment="Stretch" />
                                 </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn  x:Name="columnHeaderAmount" Header="Price" Width="75"  HeaderContainerStyle="{StaticResource headerStyle2}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridBrush}" BorderThickness="0,0,1,0" Margin="0,0,0,0">
                                        <TextBlock Margin="0,0,1,0" Name ="txtBlockAmount" Text="{Binding Path=amount}"  TextAlignment="Right" HorizontalAlignment="Stretch"  />
                                 </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn x:Name="columnHeaderSku" Header="SKU" Width="100"  HeaderContainerStyle="{StaticResource headerStyle2}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridBrush}" BorderThickness="0,0,1,0" Margin="0,0,0,0">
                                        <TextBlock Margin="1,0,0,0" Name="txtBlockSku"  Text="{Binding Path=sku}"   HorizontalAlignment="Stretch" />
                                </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>


                        <GridViewColumn x:Name="columnHeaderDept" Header="Department" Width="100"  HeaderContainerStyle="{StaticResource headerStyle2}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridBrush}" BorderThickness="0,0,1,0" Margin="0,0,0,0">
                                        <TextBlock Margin="0,0,1,0" Name ="txtBlockDept" Text="{Binding Path=dept}"   HorizontalAlignment="Stretch"  />
                                 </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn  x:Name="columnHeaderItemGroup" Header="Item group" Width="100"  HeaderContainerStyle="{StaticResource headerStyle2}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridBrush}" BorderThickness="0,0,1,0" Margin="0,0,0,0">
                                        <TextBlock Margin="1,0,0,0" Name ="txtBlockItemGroup" Text="{Binding Path=item_group}"   HorizontalAlignment="Stretch"  />
                                 </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn  x:Name="columnHeaderPlu" Header="Plu" Width="100"  HeaderContainerStyle="{StaticResource headerStyle2}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridBrush}" BorderThickness="0,0,0,0" Margin="0,0,0,0">
                                        <TextBlock Margin="1,0,0,0" Name ="txtBloclkPlu" Text="{Binding Path=plu}"   HorizontalAlignment="Stretch"  />
                                 </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>

        </Grid>
    </Border>

</UserControl>
