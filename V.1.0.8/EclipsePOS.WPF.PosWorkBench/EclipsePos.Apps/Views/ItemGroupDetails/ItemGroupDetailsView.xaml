<UserControl x:Class="EclipsePos.Apps.Views.ItemGroupDetails.ItemGroupDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Name="rootControl" >
    <UserControl.Resources>
        <SolidColorBrush x:Key="BottomPanelBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="OutboxHeaderBrush" Color="{DynamicResource SurfaceColor}"/>

        <SolidColorBrush x:Key="HeaderTextBrush" Color="{DynamicResource InkColor}"/>
        <SolidColorBrush x:Key="GridBodyBrush" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="MenuHeadBrush" Color="{DynamicResource CanvasColor}"/>

        <LinearGradientBrush x:Key="GridShadowBrush" EndPoint="0.5,1.057" StartPoint="0.5,-0.057">
            <GradientStop Color="#33FFFFFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="{DynamicResource CanvasColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource LineColor}"/>

        <Style x:Key="GlassyButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}"/>


    </UserControl.Resources>
    <Border   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,00,10,10" Width="Auto" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1,1,1,1" >
        <Grid Name="MyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Background="{StaticResource MenuHeadBrush}" Margin="0,2,0,2">
                <TextBlock   Name="txtBlockMenuName" Text="Item Groups"  Foreground="#FFFFFFFF" FontSize="17" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
