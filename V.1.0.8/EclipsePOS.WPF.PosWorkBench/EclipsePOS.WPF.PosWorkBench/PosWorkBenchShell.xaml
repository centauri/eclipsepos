<Window x:Class="EclipsePOS.WPF.PosWorkBench.PosWorkBenchShell"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:cal="http://www.codeplex.com/CompositeWPF" Closing="Window_Closing"
 Title="EclipsePOS · Retail" Name="PosWindow" Width="1440" Height="900" MinWidth="1000" MinHeight="700"
 WindowState="Maximized" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="16"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="True">
   <Button DockPanel.Dock="Right" Content="Light / dark" Click="ToggleTheme" Width="136"/>
   <TextBlock DockPanel.Dock="Left" Text="eclipse / retail" FontSize="26" FontWeight="SemiBold" Margin="8,0,32,0" VerticalAlignment="Center"/>
   <ItemsControl x:Name="InvoiceHeaderRegion" cal:RegionManager.RegionName="InvoiceHeaderRegion" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,12,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="440"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><ItemsControl x:Name="LeftMenuRegion" cal:RegionManager.RegionName="LeftMenuRegion"/></ScrollViewer>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><ItemsControl x:Name="RightMenuRegion" cal:RegionManager.RegionName="RightMenuRegion"/></ScrollViewer>
      <ItemsControl Grid.ColumnSpan="2" x:Name="TableRegion" cal:RegionManager.RegionName="TableRegion"/>
      <ItemsControl Grid.ColumnSpan="2" x:Name="LogRegion" cal:RegionManager.RegionName="LogRegion"/>
     </Grid>
    </Border>
    <ItemsControl Grid.Row="1" x:Name="NavigatorRegion" cal:RegionManager.RegionName="NavigatorRegion" Margin="0,12,0,0"/>
   </Grid>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Current sale" FontSize="21" FontWeight="SemiBold"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><ItemsControl x:Name="InvoiceRegion" cal:RegionManager.RegionName="InvoiceRegion"/></ScrollViewer>
     <ItemsControl Grid.Row="2" x:Name="InvoiceTotalRegion" cal:RegionManager.RegionName="InvoiceTotalRegion" Margin="0,12,0,8"/>
     <ItemsControl Grid.Row="3" x:Name="OperatorPromptRegion" cal:RegionManager.RegionName="OperatorPromptRegion"/>
     <ItemsControl Grid.Row="4" x:Name="KeyPadRegion" cal:RegionManager.RegionName="KeyPadRegion"/>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="EclipsePOS Workbench · Original transaction engine · Device configuration in System Manager" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0"/>
 </Grid>
</Window>
