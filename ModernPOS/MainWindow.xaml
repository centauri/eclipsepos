<Window x:Class="EclipsePOS.Modern.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Eclipse / Market — Retail POS" Width="1440" Height="940" MinWidth="1120" MinHeight="800" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="15">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="eclipse / market" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="RETAIL STUDIO     /     KASSA 01" Foreground="{DynamicResource Muted}" FontSize="12" Margin="1,6,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Demo winkel · Medewerker Alex" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="◐  Thema" Click="Theme_Click"/><Button Content="Apparaten" Click="Devices_Click"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="Search" AutomationProperties.Name="Zoek artikel of scan barcode" ToolTip="Zoek op naam of categorie, of scan een barcode en druk Enter" TextChanged="Search_Changed" KeyDown="Search_KeyDown"/>
     <Button Grid.Column="1" Content="Zoek / scan ↵" Click="Scan_Click"/>
    </Grid>
    <TextBlock Grid.Row="1" Text="Zoek een artikel of scan een barcode" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,8,0,12"/>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Categories" Orientation="Horizontal" Margin="-4,0,0,16"/></ScrollViewer>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
     <ItemsControl x:Name="Products"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Width="211" Height="184" Padding="20" HorizontalContentAlignment="Stretch" Click="Product_Click" Tag="{Binding}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="{Binding Icon}" FontSize="39" Foreground="{DynamicResource Accent}"/>
         <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8"/>
         <Grid Grid.Row="2"><TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding PriceLabel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
        </Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="20" Padding="22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Huidige verkoop" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ItemCount" Text="Je mandje is nog leeg" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <ItemsControl x:Name="CartItems"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
        <StackPanel><Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
         <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,5"/>
         <StackPanel Orientation="Horizontal"><Button Content="−" Width="56" Padding="0" Click="Minus_Click" Tag="{Binding}" AutomationProperties.Name="Verminder aantal"/><Button Content="+" Width="56" Padding="0" Click="Plus_Click" Tag="{Binding}" AutomationProperties.Name="Verhoog aantal"/><Button Content="Verwijder" Click="Remove_Click" Tag="{Binding}"/></StackPanel>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
     <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="Vat" Foreground="{DynamicResource Muted}"/>
      <Grid Margin="0,12,0,18"><TextBlock Text="Totaal" FontSize="23"/><TextBlock x:Name="Total" Text="€ 0,00" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
      <Button x:Name="Checkout" Content="Afrekenen  →" Background="{DynamicResource Accent}" Foreground="White" Height="68" FontSize="19" HorizontalContentAlignment="Center" Click="Checkout_Click"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Wis verkoop" Click="Clear_Click"/><Button Grid.Column="1" Content="Laatste bon" Click="Receipt_Click"/></Grid>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="Status" Text="DEMO · geen apparaten aangesloten" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,230,0"/><TextBlock Text="DEMO · geen echte pinbetaling" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid>
 </Grid>
</Window>
